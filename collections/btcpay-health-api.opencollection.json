{
  "opencollection": "1.0.0",
  "info": {
    "name": "BTCPay Greenfield API Keys Health API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get health status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{btcpay-host}/api/v1/health"
          },
          "docs": "Check the instance health status"
        }
      ]
    }
  ],
  "bundled": true
}